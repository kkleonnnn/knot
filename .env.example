# ── LLM API Keys (fill in the ones you use) ──────────────────────────
# v0.6.5.4 OR-only：默认走 OpenRouter（1 个 key 通所有模型）——内测首选填这个：
OPENROUTER_API_KEY=sk-or-...
# 直连 provider keys（OR-only 下多为休眠，保留兼容）：
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
DEEPSEEK_API_KEY=...

# ── Optional: custom base URLs (e.g. for proxies) ─────────────────────
# ANTHROPIC_BASE_URL=https://your-proxy.example.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Default LLM model ─────────────────────────────────────────────────
# v0.6.0.8 MUST-2：默认切到 OpenRouter 通道（OR-only catalog；1 个 key 通所有模型）
# 内测期建议 OR；direct provider keys 保留至 Day 28+ Phase B 三方会议拍板是否清理
DEFAULT_MODEL=anthropic/claude-haiku-4.5

# ── Database (Apache Doris / MySQL compatible) ────────────────────────
DB_HOST=localhost
DB_PORT=9030
DB_USER=root
DB_PASSWORD=
DB_DATABASE=knot_demo

# ── JWT secret (v0.6.0.8 MUST-1: 必须替换；fail-fast 拦默认占位) ──────
# 生成: openssl rand -hex 32  （32 字节十六进制 = 64 字符；安全建议 ≥16 字符）
# 缺失 / 用历史默认占位 / 长度 < 16 → 启动 sys.exit(1) + 友好彩色提示
JWT_SECRET=

# ── v0.4.5: Field-level encryption master key (REQUIRED) ──────────────
# 应用层加密 6 类敏感字段（API Key / DB 密码）的 Fernet 主密钥。
# 缺失 → 启动失败（fail-fast，无 fallback）。
# 生成: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 务必备份至独立保险位置；丢失会导致历史加密数据永久不可读
# v0.6.0：env 名 KNOT_MASTER_KEY（v0.5.x 双源兼容已撤回；详 CHANGELOG v0.6.0）
KNOT_MASTER_KEY=

# ── v0.4.6: 审计日志 ──────────────────────────────────────────────
# retention 默认 90 天，admin 可在 PUT /api/admin/audit-config 调整（7~3650）
# 配置存于 app_settings.audit.retention_days（不读 env，仅 admin 路由）
# 清理脚本：python3 -m knot.scripts.purge_audit_log [--dry-run]

# ── SQLite path for app metadata ──────────────────────────────────────
# SQLITE_DB_PATH=./data/knot.db

# ── v0.6.0.15: CORS allow_origins（生产部署必须显式配置）─────────────
# 逗号分隔；未设置时启动期打印 WARNING + 兜底 "*"（dev / docker-compose 单机部署 OK）
# 显式配置 → 自动启用 allow_credentials=True（cookie / Authorization 透传）
# 示例：KNOT_CORS_ORIGINS=https://knot.example.com,https://app.example.com
# KNOT_CORS_ORIGINS=

# ── v0.6.2 2FA / v0.7 语义层 / v0.7.7 monitors / v0.8 调度 · 上传 admin 口令 ──
# admin 初始口令（v0.8.20 F7）：设则用之，未设则首启随机生成 + 日志打印一次（防跨部署同一 admin123）
# KNOT_INITIAL_ADMIN_PASSWORD=
# 2FA 强制（默认 true；eval/demo 可 false）：
# KNOT_TOTP_REQUIRED=true
# admin TOTP 应急后门（用完即撤）：
# KNOT_TOTP_BYPASS_ADMIN=false
# 5 层语义层激活门（激活门 2026-07-21 达标已启用；代码默认 off，生产设 =true 开）：
KNOT_SEMANTIC_LAYER=true
# HTTP 数据源 egress 白名单（逗号分隔 host；未设=全拒 HTTP 源）：
# KNOT_HTTP_ALLOWED_HOSTS=
# monitor webhook egress 白名单（v0.7.7；未设=全拒）：
# KNOT_WEBHOOK_ALLOWED_HOSTS=
# BI 报表定时刷新调度器 tick 端点 bearer（v0.8.17；未设=/api/bi/scheduler/tick 返 503）：
# KNOT_SCHEDULER_TOKEN=
# 严格只读授权探测（默认 0）：
# STRICT_READONLY_GRANTS=0

# ── Tuning knobs ──────────────────────────────────────────────────────
AGENT_MAX_STEPS=5
SCHEMA_FILTER_MAX_TABLES=10
RAG_TOP_K=5
FEW_SHOT_MAX_EXAMPLES=4
